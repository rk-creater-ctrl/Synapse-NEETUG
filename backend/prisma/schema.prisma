generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  STUDENT
  MENTOR
  CONTENT_EDITOR
  MODERATOR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum VideoProvider {
  LOCAL
  MOCK
  MUX
  CLOUDFLARE_STREAM
}

enum RevisionType {
  FORMULA
  REACTION
  BIOLOGY_FACT
  NCERT_HIGHLIGHT
  SHORT_NOTE
}

enum FlashcardReviewResult {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ContentImportTarget {
  ACADEMIC_EXAM
  ACADEMIC_SUBJECT
  ACADEMIC_CLASS
  ACADEMIC_CHAPTER
  ACADEMIC_TOPIC
  ACADEMIC_SUBTOPIC
  VIDEO
  REVISION_ITEM
  FLASHCARD
  QUESTION
}

enum ContentImportStatus {
  PREVIEWED
  APPLYING
  APPLIED
  FAILED
}

enum ContentImportDuplicateStrategy {
  ERROR
  SKIP
  UPDATE
}

enum ContentImportRowStatus {
  VALID
  INVALID
  APPLIED
  SKIPPED
  FAILED
}

enum QuestionType {
  SINGLE_CORRECT_MCQ
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSourceType {
  CURATED
  PYQ
}

enum QuestionPracticeSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum DailyStudyModuleStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum DailyStudyTaskType {
  QUESTION
  FLASHCARD
  REVISION
  VIDEO
}

enum DailyStudyTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum StudySessionStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  ABANDONED
}

enum StudySessionContextType {
  GENERAL
  VIDEO
  FLASHCARD
  QUESTION_PRACTICE
  TEST
  REVISION
  DAILY_STUDY
}

enum MentorBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum MentorVideoSessionStatus {
  READY
  ACTIVE
  ENDED
}

enum CommunityType {
  GROUP
  CHANNEL
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityMemberRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityAttachmentType {
  IMAGE
  DOCUMENT
}

enum CommunityReactionType {
  LIKE
  LOVE
  CELEBRATE
  INSIGHTFUL
}

enum CommunityReportReason {
  SPAM
  HARASSMENT
  ABUSE
  MISINFORMATION
  INAPPROPRIATE_CONTENT
  OTHER
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum CommunityModerationActionType {
  MESSAGE_DELETED
  MEMBER_MUTED
  MEMBER_UNMUTED
  MEMBER_BANNED
  MEMBER_UNBANNED
}

enum BillingInterval {
  ONE_TIME
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model User {
  testAttempts          TestAttempt[]
  id                String              @id @default(cuid())
  email             String              @unique
  phone             String?             @unique
  passwordHash      String
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  roles             UserRole[]
  sessions          RefreshSession[]
  devices           UserDevice[]
  studentProfile    StudentProfile?
  videoProgress     VideoProgress[]
  flashcardProgress FlashcardProgress[]
  questionPracticeSessions QuestionPracticeSession[]
  contentImportJobs ContentImportJob[]
  contentAuditEvents ContentAuditEvent[]
  dailyStudyModules DailyStudyModule[]
  studySessions    StudySession[]
  mentorProfile    MentorProfile?
  mentorBookings   MentorBooking[]
  communitiesCreated Community[]          @relation("CommunityCreator")
  communityMemberships CommunityMembership[]
  communityMessages CommunityMessage[]
  communityMessageReactions CommunityMessageReaction[]
  communityMessageReports CommunityMessageReport[] @relation("CommunityMessageReporter")
  resolvedCommunityMessageReports CommunityMessageReport[] @relation("CommunityMessageReportResolver")
  communityModerationActions CommunityModerationAction[] @relation("CommunityModerationActor")
  communityModerationTargets CommunityModerationAction[] @relation("CommunityModerationTargetUser")
  subscriptions Subscription[]
}

model SubscriptionPlan {
  id                   String          @id @default(cuid())
  code                 String          @unique
  name                 String
  description          String?
  currency             String
  priceMinor           Int
  billingInterval      BillingInterval
  billingIntervalCount Int             @default(1)
  active               Boolean         @default(true)
  published            Boolean         @default(false)
  sortOrder            Int             @default(0)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  features             PlanFeature[]
  subscriptions        Subscription[]

  @@index([active, published, sortOrder, code])
}

model PlanFeature {
  id        String           @id @default(cuid())
  planId    String
  key       String
  enabled   Boolean          @default(true)
  limit     Int?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
}

model Subscription {
  id                           String             @id @default(cuid())
  userId                       String
  planId                       String
  status                       SubscriptionStatus @default(PENDING)
  startsAt                     DateTime?
  currentPeriodStartAt         DateTime?
  currentPeriodEndAt           DateTime?
  cancelAtPeriodEnd            Boolean            @default(false)
  cancelledAt                  DateTime?
  endedAt                      DateTime?
  planCodeSnapshot             String
  planNameSnapshot             String
  currencySnapshot             String
  priceMinorSnapshot           Int
  billingIntervalSnapshot      BillingInterval
  billingIntervalCountSnapshot Int
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt
  user                         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                         SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([planId, createdAt])
  @@index([status, createdAt])
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshSession {
  id        String      @id @default(cuid())
  userId    String
  deviceId  String?
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
}

model UserDevice {
  id                    String           @id @default(cuid())
  userId                String
  installationId        String
  deviceName            String?
  platform              String?
  isPrimary             Boolean          @default(false)
  isApproved            Boolean          @default(false)
  approvedAt            DateTime?
  revokedAt             DateTime?
  approvalChallengeHash String?
  approvalExpiresAt     DateTime?
  firstSeenAt           DateTime         @default(now())
  lastSeenAt            DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions              RefreshSession[]

  @@unique([userId, installationId])
  @@index([userId, isApproved, revokedAt])
  @@index([userId, isPrimary])
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  targetExamYear    Int?
  classLevel        String?
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exam {
  tests                Test[]
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subjects      Subject[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  questions     Question[]

  @@index([isActive, displayOrder])
}

model Subject {
  tests                Test[]
  id            String          @id @default(cuid())
  examId        String
  name          String
  slug          String
  displayOrder  Int             @default(0)
  isActive      Boolean         @default(true)
  isPublished   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  exam          Exam            @relation(fields: [examId], references: [id])
  classes       AcademicClass[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  questions     Question[]
  dailyStudyTasks DailyStudyTask[]
  studySessions    StudySession[]
  mentorExpertise  MentorSubjectExpertise[]

  @@unique([examId, slug])
  @@index([examId, isActive])
}

model AcademicClass {
  tests                Test[]
  id            String         @id @default(cuid())
  subjectId     String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       Subject        @relation(fields: [subjectId], references: [id])
  chapters      Chapter[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  questions     Question[]

  @@unique([subjectId, slug])
  @@index([subjectId, isActive])
}

model Chapter {
  tests                Test[]
  id            String         @id @default(cuid())
  classId       String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  academicClass AcademicClass  @relation(fields: [classId], references: [id])
  topics        Topic[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  questions     Question[]
  dailyStudyTasks DailyStudyTask[]
  studySessions    StudySession[]

  @@unique([classId, slug])
  @@index([classId, isActive])
}

model Topic {
  tests                Test[]
  id            String         @id @default(cuid())
  chapterId     String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  chapter       Chapter        @relation(fields: [chapterId], references: [id])
  subtopics     Subtopic[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  questions     Question[]
  dailyStudyTasks DailyStudyTask[]
  studySessions    StudySession[]

  @@unique([chapterId, slug])
  @@index([chapterId, isActive])
}

model Subtopic {
  tests                Test[]
  id            String         @id @default(cuid())
  topicId       String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  topic         Topic          @relation(fields: [topicId], references: [id])
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  questions     Question[]
  dailyStudyTasks DailyStudyTask[]
  studySessions    StudySession[]

  @@unique([topicId, slug])
  @@index([topicId, isActive])
}

model MediaAsset {
  id          String      @id @default(cuid())
  provider    String
  externalKey String
  url         String?
  mimeType    String?
  sizeBytes   Int?
  metadata    Json?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  videos      Video[]
  flashcards  Flashcard[]
  questions   Question[]

  @@unique([provider, externalKey])
  @@index([provider, isActive])
  @@index([mimeType, isActive])
}

model Video {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String?
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  instructorName  String?
  thumbnailUrl    String?
  provider        VideoProvider   @default(LOCAL)
  providerAssetId String
  playbackId      String?
  mediaAssetId    String?
  durationSeconds Int?
  displayOrder    Int             @default(0)
  isFree          Boolean         @default(true)
  isPublished     Boolean         @default(false)
  isActive        Boolean         @default(true)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  exam            Exam            @relation(fields: [examId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass   @relation(fields: [academicClassId], references: [id])
  chapter         Chapter         @relation(fields: [chapterId], references: [id])
  topic           Topic           @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?       @relation(fields: [subtopicId], references: [id])
  mediaAsset      MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  progress        VideoProgress[]
  solutionForQuestions Question[] @relation("QuestionSolutionVideo")
  dailyStudyTasks DailyStudyTask[]

  @@index([chapterId, isPublished, isActive, displayOrder])
  @@index([topicId, isPublished, isActive, displayOrder])
  @@index([mediaAssetId])
}

model VideoProgress {
  id                   String    @id @default(cuid())
  studentId            String
  videoId              String
  watchedSeconds       Int       @default(0)
  lastPositionSeconds  Int       @default(0)
  completionPercentage Float     @default(0)
  completed            Boolean   @default(false)
  firstStartedAt       DateTime?
  lastWatchedAt        DateTime  @default(now())
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  student              User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video                Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId, lastWatchedAt])
}

model RevisionItem {
  id              String        @id @default(cuid())
  title           String
  type            RevisionType
  content         String
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  displayOrder    Int           @default(0)
  isPublished     Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  exam            Exam          @relation(fields: [examId], references: [id])
  subject         Subject       @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id])
  chapter         Chapter       @relation(fields: [chapterId], references: [id])
  topic           Topic         @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?     @relation(fields: [subtopicId], references: [id])
  dailyStudyTasks DailyStudyTask[]

  @@index([chapterId, topicId, type, isPublished, isActive])
}

model Flashcard {
  id              String              @id @default(cuid())
  title           String?
  frontContent    String
  backContent     String
  explanation     String?
  imageUrl        String?
  mediaAssetId    String?
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  isPublished     Boolean             @default(false)
  isActive        Boolean             @default(true)
  isPremium       Boolean             @default(false)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  exam            Exam                @relation(fields: [examId], references: [id])
  subject         Subject             @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass       @relation(fields: [academicClassId], references: [id])
  chapter         Chapter             @relation(fields: [chapterId], references: [id])
  topic           Topic               @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?           @relation(fields: [subtopicId], references: [id])
  mediaAsset      MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  progress        FlashcardProgress[]
  dailyStudyTasks DailyStudyTask[]

  @@index([topicId, isPublished, isActive, sortOrder])
  @@index([chapterId, isPublished, isActive, sortOrder])
  @@index([mediaAssetId])
}

model FlashcardProgress {
  id             String                 @id @default(cuid())
  studentId      String
  flashcardId    String
  reviewCount    Int                    @default(0)
  lastResult     FlashcardReviewResult?
  lastReviewedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  student        User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard      Flashcard              @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([studentId, flashcardId])
  @@index([studentId, lastReviewedAt])
}

model Question {
  testQuestions        TestQuestion[]
  id              String             @id @default(cuid())
  type            QuestionType       @default(SINGLE_CORRECT_MCQ)
  sourceType      QuestionSourceType @default(CURATED)
  stem            String
  explanation     String
  difficulty      QuestionDifficulty @default(MEDIUM)
  tags            String[]
  displayOrder    Int                @default(0)
  isPublished     Boolean            @default(false)
  isActive        Boolean            @default(true)
  isFree          Boolean            @default(true)
  importKey       String?            @unique
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  mediaAssetId    String?
  solutionVideoId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  exam            Exam               @relation(fields: [examId], references: [id])
  subject         Subject            @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass      @relation(fields: [academicClassId], references: [id])
  chapter         Chapter            @relation(fields: [chapterId], references: [id])
  topic           Topic              @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?          @relation(fields: [subtopicId], references: [id])
  mediaAsset      MediaAsset?        @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  solutionVideo   Video?             @relation("QuestionSolutionVideo", fields: [solutionVideoId], references: [id], onDelete: SetNull)
  options         QuestionOption[]
  pyqMetadata     QuestionPyqMetadata?
  practiceItems   QuestionPracticeItem[]
  dailyStudyTasks DailyStudyTask[]

  @@index([topicId, isActive, isPublished, isFree, displayOrder])
  @@index([chapterId, isActive, isPublished, displayOrder])
  @@index([sourceType, difficulty])
  @@index([mediaAssetId])
  @@index([solutionVideoId])
}

model QuestionOption {
  testAttemptAnswers   TestAttemptAnswer[]
  id                String                 @id @default(cuid())
  questionId        String
  position          Int
  text              String
  isCorrect         Boolean                @default(false)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  question          Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedByItems   QuestionPracticeItem[] @relation("QuestionPracticeItemSelectedOption")

  @@unique([questionId, position])
}

model QuestionPyqMetadata {
  id             String   @id @default(cuid())
  questionId     String   @unique
  sourceExam     String
  year           Int
  sessionKey     String
  paperKey       String
  questionNumber Int
  sourceNote     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([sourceExam, year, sessionKey, paperKey, questionNumber])
  @@index([year, sourceExam])
}

model QuestionPracticeSession {
  id              String                        @id @default(cuid())
  studentId       String
  selectedFilters Json
  status          QuestionPracticeSessionStatus @default(IN_PROGRESS)
  startedAt       DateTime                      @default(now())
  completedAt     DateTime?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  student         User                          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items           QuestionPracticeItem[]

  @@index([studentId, status, startedAt])
}

model QuestionPracticeItem {
  id               String                  @id @default(cuid())
  sessionId        String
  questionId       String
  sequence         Int
  selectedOptionId String?
  isCorrect        Boolean?
  timeSpentSeconds Int?
  answeredAt       DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  session          QuestionPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question         Question                @relation(fields: [questionId], references: [id])
  selectedOption   QuestionOption?         @relation("QuestionPracticeItemSelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, sequence])
  @@unique([sessionId, questionId])
  @@index([questionId])
}

model DailyStudyModule {
  id          String                 @id @default(cuid())
  studentId   String
  studyDate   DateTime               @db.Date
  status      DailyStudyModuleStatus @default(NOT_STARTED)
  generatedAt DateTime               @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  student     User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tasks       DailyStudyTask[]

  @@unique([studentId, studyDate])
  @@index([studentId, status, studyDate])
}

model DailyStudyTask {
  id              String               @id @default(cuid())
  moduleId        String
  subjectId       String
  type            DailyStudyTaskType
  status          DailyStudyTaskStatus @default(PENDING)
  displayOrder    Int
  chapterId       String?
  topicId         String?
  subtopicId      String?
  questionId      String?
  flashcardId     String?
  revisionItemId  String?
  videoId         String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  module          DailyStudyModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subject         Subject              @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  chapter         Chapter?             @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic           Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic        Subtopic?            @relation(fields: [subtopicId], references: [id], onDelete: SetNull)
  question        Question?            @relation(fields: [questionId], references: [id], onDelete: SetNull)
  flashcard       Flashcard?           @relation(fields: [flashcardId], references: [id], onDelete: SetNull)
  revisionItem    RevisionItem?        @relation(fields: [revisionItemId], references: [id], onDelete: SetNull)
  video           Video?               @relation(fields: [videoId], references: [id], onDelete: SetNull)

  @@unique([moduleId, subjectId, displayOrder])
  @@index([moduleId, status])
  @@index([subjectId, status])
  @@index([questionId])
  @@index([flashcardId])
  @@index([revisionItemId])
  @@index([videoId])
}

model StudySession {
  id                   String                  @id @default(cuid())
  studentId            String
  status               StudySessionStatus      @default(IN_PROGRESS)
  contextType          StudySessionContextType @default(GENERAL)
  subjectId            String?
  chapterId            String?
  topicId              String?
  subtopicId           String?
  startedAt            DateTime                @default(now())
  pausedAt             DateTime?
  completedAt          DateTime?
  abandonedAt          DateTime?
  lastResumedAt        DateTime?
  accumulatedSeconds   Int                     @default(0)
  finalDurationSeconds Int?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  student              User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject              Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapter              Chapter?                @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  topic                Topic?                  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic             Subtopic?               @relation(fields: [subtopicId], references: [id], onDelete: SetNull)

  @@index([studentId, startedAt])
  @@index([studentId, status])
  @@index([studentId, completedAt])
  @@index([subjectId, startedAt])
}

model MentorProfile {
  id              String                    @id @default(cuid())
  userId          String                    @unique
  fullName        String
  headline        String?
  bio             String?
  profileImageUrl String?
  experienceYears Int                       @default(0)
  isActive        Boolean                   @default(true)
  timezone        String                    @default("UTC")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertise       MentorSubjectExpertise[]
  availability    MentorAvailability[]
  bookings        MentorBooking[]

  @@index([isActive])
}

model MentorAvailability {
  id              String        @id @default(cuid())
  mentorProfileId String
  /// Weekly recurrence uses 0 = Sunday through 6 = Saturday.
  dayOfWeek       Int
  startMinute     Int
  endMinute       Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)

  @@unique([mentorProfileId, dayOfWeek, startMinute, endMinute])
  @@index([mentorProfileId, dayOfWeek])
}

model MentorBooking {
  id               String              @id @default(cuid())
  mentorProfileId  String
  studentUserId    String
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  status           MentorBookingStatus @default(PENDING)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  mentorProfile    MentorProfile       @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  student          User                @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  videoSession     MentorVideoSession?

  @@index([mentorProfileId, scheduledStartAt])
  @@index([studentUserId, scheduledStartAt])
  @@index([status])
}

model MentorVideoSession {
  id              String                   @id @default(cuid())
  mentorBookingId String                   @unique
  status          MentorVideoSessionStatus @default(READY)
  startedAt       DateTime?
  endedAt         DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  mentorBooking   MentorBooking            @relation(fields: [mentorBookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

model MentorSubjectExpertise {
  mentorProfileId String
  subjectId       String
  createdAt       DateTime      @default(now())
  mentorProfile   MentorProfile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([mentorProfileId, subjectId])
  @@index([subjectId])
}

model Community {
  id              String              @id @default(cuid())
  name            String
  description     String?
  type            CommunityType
  visibility      CommunityVisibility
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdBy       User                @relation("CommunityCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  memberships     CommunityMembership[]
  messages        CommunityMessage[]
  messageReports  CommunityMessageReport[]
  moderationActions CommunityModerationAction[]

  @@index([createdByUserId, createdAt])
  @@index([visibility, type, createdAt])
}

model CommunityMembership {
  id          String              @id @default(cuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  mutedUntil  DateTime?
  bannedAt    DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  community   Community           @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId, communityId])
  @@index([communityId, role])
}

model CommunityMessage {
  id               String            @id @default(cuid())
  communityId      String
  authorUserId     String
  content          String?
  replyToMessageId String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  community        Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author           User              @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  replyTo          CommunityMessage? @relation("CommunityMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          CommunityMessage[] @relation("CommunityMessageReplies")
  attachments      CommunityMessageAttachment[]
  reactions        CommunityMessageReaction[]
  reports          CommunityMessageReport[]
  moderationActions CommunityModerationAction[] @relation("CommunityModerationTargetMessage")

  @@index([communityId, createdAt, id])
  @@index([replyToMessageId, createdAt, id])
  @@index([authorUserId, createdAt])
}

model CommunityMessageAttachment {
  id               String                  @id @default(cuid())
  messageId        String
  type             CommunityAttachmentType
  storageKey       String                  @unique
  originalFileName String
  mimeType         String
  sizeBytes        Int
  position         Int
  createdAt        DateTime                @default(now())
  message          CommunityMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, position])
  @@index([messageId, position])
}

model CommunityMessageReaction {
  id        String                @id @default(cuid())
  messageId String
  userId    String
  type      CommunityReactionType
  createdAt DateTime              @default(now())
  message   CommunityMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([messageId, userId])
  @@index([messageId, type])
  @@index([userId, messageId])
}

model CommunityMessageReport {
  id               String                @id @default(cuid())
  communityId      String
  messageId        String
  reporterUserId   String
  reason           CommunityReportReason
  details          String?
  status           CommunityReportStatus @default(OPEN)
  createdAt        DateTime              @default(now())
  resolvedAt       DateTime?
  resolvedByUserId String?
  community        Community             @relation(fields: [communityId], references: [id], onDelete: Cascade)
  message          CommunityMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter         User                  @relation("CommunityMessageReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  resolvedBy       User?                 @relation("CommunityMessageReportResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterUserId])
  @@index([communityId, status, createdAt])
  @@index([reporterUserId, createdAt])
}

model CommunityModerationAction {
  id              String                        @id @default(cuid())
  communityId     String
  actorUserId     String
  targetUserId    String?
  targetMessageId String?
  action          CommunityModerationActionType
  reason          String?
  createdAt       DateTime                      @default(now())
  community       Community                     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  actor           User                          @relation("CommunityModerationActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetUser      User?                         @relation("CommunityModerationTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetMessage   CommunityMessage?             @relation("CommunityModerationTargetMessage", fields: [targetMessageId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetMessageId, createdAt])
}

model ContentImportJob {
  id                String                         @id @default(cuid())
  target            ContentImportTarget
  status            ContentImportStatus            @default(PREVIEWED)
  originalFilename  String
  checksum          String
  duplicateStrategy ContentImportDuplicateStrategy @default(ERROR)
  createdByUserId   String
  totalRows         Int                            @default(0)
  validRows         Int                            @default(0)
  invalidRows       Int                            @default(0)
  insertedRows      Int                            @default(0)
  updatedRows       Int                            @default(0)
  skippedRows       Int                            @default(0)
  failedRows        Int                            @default(0)
  previewedAt       DateTime                       @default(now())
  appliedAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  createdBy         User                           @relation(fields: [createdByUserId], references: [id])
  rows              ContentImportRow[]
  auditEvents       ContentAuditEvent[]

  @@index([createdByUserId, createdAt])
  @@index([status, createdAt])
  @@index([target, createdAt])
}

model ContentImportRow {
  id                String                 @id @default(cuid())
  jobId             String
  rowNumber         Int
  normalizedData    Json
  status            ContentImportRowStatus @default(VALID)
  errorCode         String?
  errorMessage      String?
  resultingEntityId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  job               ContentImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
}

model ContentAuditEvent {
  id          String            @id @default(cuid())
  actorUserId String
  entityType  String
  entityId    String
  action      String
  beforeData  Json?
  afterData   Json?
  importJobId String?
  createdAt   DateTime          @default(now())
  actor       User              @relation(fields: [actorUserId], references: [id])
  importJob   ContentImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([importJobId])
}

enum TestAttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  ABANDONED
}

model Test {
  id                 String          @id @default(cuid())
  title              String
  description        String?
  instructions       String?
  examId             String
  subjectId          String?
  academicClassId    String?
  chapterId          String?
  topicId            String?
  subtopicId         String?
  durationMinutes    Int
  totalMarks         Float
  isPublished        Boolean         @default(false)
  isActive           Boolean         @default(true)
  isFree             Boolean         @default(false)
  availableFrom      DateTime?
  availableUntil     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  exam               Exam            @relation(fields: [examId], references: [id], onDelete: Restrict)
  subject            Subject?        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicClass      AcademicClass?  @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  chapter            Chapter?        @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  topic              Topic?          @relation(fields: [topicId], references: [id], onDelete: Restrict)
  subtopic           Subtopic?       @relation(fields: [subtopicId], references: [id], onDelete: Restrict)
  sections           TestSection[]
  questions          TestQuestion[]
  attempts           TestAttempt[]

  @@index([examId, isActive, isPublished])
  @@index([subjectId, academicClassId, isActive, isPublished])
  @@index([chapterId, topicId, isActive, isPublished])
  @@index([availableFrom, availableUntil])
}

model TestSection {
  id           String         @id @default(cuid())
  testId       String
  title        String
  instructions String?
  displayOrder Int
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  test         Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions    TestQuestion[]

  @@unique([testId, displayOrder])
  @@index([testId])
}

model TestQuestion {
  id            String              @id @default(cuid())
  testId        String
  sectionId     String
  questionId    String
  displayOrder  Int
  marks         Float
  negativeMarks Float               @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  test          Test                @relation(fields: [testId], references: [id], onDelete: Cascade)
  section       TestSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question      Question            @relation(fields: [questionId], references: [id], onDelete: Restrict)
  attemptAnswers TestAttemptAnswer[]

  @@unique([testId, questionId])
  @@unique([sectionId, displayOrder])
  @@index([testId, displayOrder])
  @@index([questionId])
}

model TestAttempt {
  id                String             @id @default(cuid())
  studentId         String
  testId            String
  status            TestAttemptStatus  @default(IN_PROGRESS)
  startedAt         DateTime           @default(now())
  deadlineAt        DateTime
  submittedAt       DateTime?
  autoSubmittedAt   DateTime?
  score             Float?
  correctCount      Int?
  incorrectCount    Int?
  unansweredCount   Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  student           User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test              Test               @relation(fields: [testId], references: [id], onDelete: Restrict)
  answers           TestAttemptAnswer[]

  @@index([studentId, status, startedAt])
  @@index([testId, status])
  @@index([deadlineAt])
}

model TestAttemptAnswer {
  id               String       @id @default(cuid())
  attemptId        String
  testQuestionId   String
  selectedOptionId String?
  isMarkedForReview Boolean     @default(false)
  answeredAt       DateTime?
  elapsedSeconds   Int?
  isCorrect        Boolean?
  awardedMarks     Float?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  attempt          TestAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testQuestion     TestQuestion @relation(fields: [testQuestionId], references: [id], onDelete: Restrict)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, testQuestionId])
  @@index([attemptId])
  @@index([testQuestionId])
  @@index([selectedOptionId])
}
