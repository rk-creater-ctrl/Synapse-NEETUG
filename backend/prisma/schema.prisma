generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  STUDENT
  MENTOR
  CONTENT_EDITOR
  MODERATOR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

enum VideoProvider {
  LOCAL
  MOCK
  MUX
  CLOUDFLARE_STREAM
}

enum RevisionType {
  FORMULA
  REACTION
  BIOLOGY_FACT
  NCERT_HIGHLIGHT
  SHORT_NOTE
}

enum FlashcardReviewResult {
  AGAIN
  HARD
  GOOD
  EASY
}

enum ContentImportTarget {
  ACADEMIC_EXAM
  ACADEMIC_SUBJECT
  ACADEMIC_CLASS
  ACADEMIC_CHAPTER
  ACADEMIC_TOPIC
  ACADEMIC_SUBTOPIC
  VIDEO
  REVISION_ITEM
  FLASHCARD
}

enum ContentImportStatus {
  PREVIEWED
  APPLYING
  APPLIED
  FAILED
}

enum ContentImportDuplicateStrategy {
  ERROR
  SKIP
  UPDATE
}

enum ContentImportRowStatus {
  VALID
  INVALID
  APPLIED
  SKIPPED
  FAILED
}

model User {
  id                String              @id @default(cuid())
  email             String              @unique
  phone             String?             @unique
  passwordHash      String
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  roles             UserRole[]
  sessions          RefreshSession[]
  devices           UserDevice[]
  studentProfile    StudentProfile?
  videoProgress     VideoProgress[]
  flashcardProgress FlashcardProgress[]
  contentImportJobs ContentImportJob[]
  contentAuditEvents ContentAuditEvent[]
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshSession {
  id        String      @id @default(cuid())
  userId    String
  deviceId  String?
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([deviceId])
  @@index([expiresAt])
}

model UserDevice {
  id                    String           @id @default(cuid())
  userId                String
  installationId        String
  deviceName            String?
  platform              String?
  isPrimary             Boolean          @default(false)
  isApproved            Boolean          @default(false)
  approvedAt            DateTime?
  revokedAt             DateTime?
  approvalChallengeHash String?
  approvalExpiresAt     DateTime?
  firstSeenAt           DateTime         @default(now())
  lastSeenAt            DateTime         @default(now())
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions              RefreshSession[]

  @@unique([userId, installationId])
  @@index([userId, isApproved, revokedAt])
  @@index([userId, isPrimary])
}

model StudentProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  fullName          String
  targetExamYear    Int?
  classLevel        String?
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exam {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subjects      Subject[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]

  @@index([isActive, displayOrder])
}

model Subject {
  id            String          @id @default(cuid())
  examId        String
  name          String
  slug          String
  displayOrder  Int             @default(0)
  isActive      Boolean         @default(true)
  isPublished   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  exam          Exam            @relation(fields: [examId], references: [id])
  classes       AcademicClass[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]

  @@unique([examId, slug])
  @@index([examId, isActive])
}

model AcademicClass {
  id            String         @id @default(cuid())
  subjectId     String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       Subject        @relation(fields: [subjectId], references: [id])
  chapters      Chapter[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]

  @@unique([subjectId, slug])
  @@index([subjectId, isActive])
}

model Chapter {
  id            String         @id @default(cuid())
  classId       String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  academicClass AcademicClass  @relation(fields: [classId], references: [id])
  topics        Topic[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]

  @@unique([classId, slug])
  @@index([classId, isActive])
}

model Topic {
  id            String         @id @default(cuid())
  chapterId     String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  chapter       Chapter        @relation(fields: [chapterId], references: [id])
  subtopics     Subtopic[]
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]

  @@unique([chapterId, slug])
  @@index([chapterId, isActive])
}

model Subtopic {
  id            String         @id @default(cuid())
  topicId       String
  name          String
  slug          String
  displayOrder  Int            @default(0)
  isActive      Boolean        @default(true)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  topic         Topic          @relation(fields: [topicId], references: [id])
  videos        Video[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]

  @@unique([topicId, slug])
  @@index([topicId, isActive])
}

model MediaAsset {
  id          String      @id @default(cuid())
  provider    String
  externalKey String
  url         String?
  mimeType    String?
  sizeBytes   Int?
  metadata    Json?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  videos      Video[]
  flashcards  Flashcard[]

  @@unique([provider, externalKey])
  @@index([provider, isActive])
  @@index([mimeType, isActive])
}

model Video {
  id              String          @id @default(cuid())
  title           String
  slug            String          @unique
  description     String?
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  instructorName  String?
  thumbnailUrl    String?
  provider        VideoProvider   @default(LOCAL)
  providerAssetId String
  playbackId      String?
  mediaAssetId    String?
  durationSeconds Int?
  displayOrder    Int             @default(0)
  isFree          Boolean         @default(true)
  isPublished     Boolean         @default(false)
  isActive        Boolean         @default(true)
  publishedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  exam            Exam            @relation(fields: [examId], references: [id])
  subject         Subject         @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass   @relation(fields: [academicClassId], references: [id])
  chapter         Chapter         @relation(fields: [chapterId], references: [id])
  topic           Topic           @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?       @relation(fields: [subtopicId], references: [id])
  mediaAsset      MediaAsset?     @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  progress        VideoProgress[]

  @@index([chapterId, isPublished, isActive, displayOrder])
  @@index([topicId, isPublished, isActive, displayOrder])
  @@index([mediaAssetId])
}

model VideoProgress {
  id                   String    @id @default(cuid())
  studentId            String
  videoId              String
  watchedSeconds       Int       @default(0)
  lastPositionSeconds  Int       @default(0)
  completionPercentage Float     @default(0)
  completed            Boolean   @default(false)
  firstStartedAt       DateTime?
  lastWatchedAt        DateTime  @default(now())
  completedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  student              User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  video                Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([studentId, videoId])
  @@index([studentId, lastWatchedAt])
}

model RevisionItem {
  id              String        @id @default(cuid())
  title           String
  type            RevisionType
  content         String
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  displayOrder    Int           @default(0)
  isPublished     Boolean       @default(false)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  exam            Exam          @relation(fields: [examId], references: [id])
  subject         Subject       @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass @relation(fields: [academicClassId], references: [id])
  chapter         Chapter       @relation(fields: [chapterId], references: [id])
  topic           Topic         @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?     @relation(fields: [subtopicId], references: [id])

  @@index([chapterId, topicId, type, isPublished, isActive])
}

model Flashcard {
  id              String              @id @default(cuid())
  title           String?
  frontContent    String
  backContent     String
  explanation     String?
  imageUrl        String?
  mediaAssetId    String?
  examId          String
  subjectId       String
  academicClassId String
  chapterId       String
  topicId         String
  subtopicId      String?
  isPublished     Boolean             @default(false)
  isActive        Boolean             @default(true)
  isPremium       Boolean             @default(false)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  exam            Exam                @relation(fields: [examId], references: [id])
  subject         Subject             @relation(fields: [subjectId], references: [id])
  academicClass   AcademicClass       @relation(fields: [academicClassId], references: [id])
  chapter         Chapter             @relation(fields: [chapterId], references: [id])
  topic           Topic               @relation(fields: [topicId], references: [id])
  subtopic        Subtopic?           @relation(fields: [subtopicId], references: [id])
  mediaAsset      MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  progress        FlashcardProgress[]

  @@index([topicId, isPublished, isActive, sortOrder])
  @@index([chapterId, isPublished, isActive, sortOrder])
  @@index([mediaAssetId])
}

model FlashcardProgress {
  id             String                 @id @default(cuid())
  studentId      String
  flashcardId    String
  reviewCount    Int                    @default(0)
  lastResult     FlashcardReviewResult?
  lastReviewedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  student        User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  flashcard      Flashcard              @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([studentId, flashcardId])
  @@index([studentId, lastReviewedAt])
}

model ContentImportJob {
  id                String                         @id @default(cuid())
  target            ContentImportTarget
  status            ContentImportStatus            @default(PREVIEWED)
  originalFilename  String
  checksum          String
  duplicateStrategy ContentImportDuplicateStrategy @default(ERROR)
  createdByUserId   String
  totalRows         Int                            @default(0)
  validRows         Int                            @default(0)
  invalidRows       Int                            @default(0)
  insertedRows      Int                            @default(0)
  updatedRows       Int                            @default(0)
  skippedRows       Int                            @default(0)
  failedRows        Int                            @default(0)
  previewedAt       DateTime                       @default(now())
  appliedAt         DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  createdBy         User                           @relation(fields: [createdByUserId], references: [id])
  rows              ContentImportRow[]
  auditEvents       ContentAuditEvent[]

  @@index([createdByUserId, createdAt])
  @@index([status, createdAt])
  @@index([target, createdAt])
}

model ContentImportRow {
  id                String                 @id @default(cuid())
  jobId             String
  rowNumber         Int
  normalizedData    Json
  status            ContentImportRowStatus @default(VALID)
  errorCode         String?
  errorMessage      String?
  resultingEntityId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  job               ContentImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@index([jobId, status])
}

model ContentAuditEvent {
  id          String            @id @default(cuid())
  actorUserId String
  entityType  String
  entityId    String
  action      String
  beforeData  Json?
  afterData   Json?
  importJobId String?
  createdAt   DateTime          @default(now())
  actor       User              @relation(fields: [actorUserId], references: [id])
  importJob   ContentImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([importJobId])
}
