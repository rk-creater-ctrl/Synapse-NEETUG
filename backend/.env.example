NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://synapse:synapse@localhost:5432/synapse_neetug?schema=public
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-minimum-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Optional private local attachment storage for Phase 12E development.
COMMUNITY_ATTACHMENT_STORAGE_DIR=./storage/community-attachments
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-this-development-password
